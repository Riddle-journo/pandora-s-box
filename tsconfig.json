{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "server/store/**/*.js",
    "server/llm.js",
    "server/fetchers/http.js",
    "server/config.js",
    "server/util/**/*.js"
  ]
}
