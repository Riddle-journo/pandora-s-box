{
  "name": "pandoros-box",
  "version": "0.1.0",
  "description": "Pandoro's Box — Evidence-based accountability scorecards for elected representatives in India. Every claim cited to an admissible source.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "ops": "node server/index.js",
    "seed": "node server/orchestration/seed.js",
    "generate": "node server/publishing/report-generator.js",
    "ingest": "node server/orchestration/ingest.js",
    "extract:directorships": "node server/extractors/directorships.js && node server/extractors/directorship-verify.js",
    "extract:directorships:all": "node server/extractors/directorships-run-all.js",
    "extract:party-finance": "node server/extractors/party-finance.js",
    "extract:financial-links": "node server/extractors/financial-links.js",
    "extract:prose": "node server/extractors/prose-llm.js",
    "extract:all": "node server/extractors/extract-all.js",
    "opendata:catalog": "node server/catalogue/opendata-catalog.js",
    "detect:ledger": "node server/detectors/ledger-detectors.js",
    "detect:denominators": "node server/detectors/denominator-detectors.js",
    "reingest:party-finance": "node scripts/reingest-party-finance.js",
    "worker": "node server/orchestration/worker.js",
    "worker:once": "node server/orchestration/worker.js --once",
    "db:backup": "node server/platform/db-maintenance.js backup",
    "db:check": "node server/platform/db-maintenance.js check",
    "db:doctor": "node server/platform/db-maintenance.js doctor",
    "db:vacuum": "node server/platform/db-maintenance.js vacuum",
    "db:maintain": "node server/platform/db-maintenance.js all",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "coverage": "c8 --reporter=text-summary --reporter=html --all --src server --exclude \"server/data/**\" node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "smoke:ui": "node scripts/smoke-ui.js",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke",
    "prod:start": "pm2 start ecosystem.config.cjs",
    "prod:stop": "pm2 stop pandoros",
    "prod:status": "pm2 status",
    "prod:logs": "pm2 logs pandoros --lines 100 --nostream"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "fflate": "^0.8.3",
    "openai": "^4.47.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "pdf-to-img": "^6.2.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "pm2": "^7.0.3",
    "typescript": "^7.0.2"
  }
}
