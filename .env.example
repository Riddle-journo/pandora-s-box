# Copy this file to .env and fill in your values.

# ============================================================
# OPTION A: GLM-5.2 via OpenRouter API (recommended for quality)
# Get a free key at: https://openrouter.ai
# Model: zhipuai/glm-5-2  (check openrouter.ai/models for exact slug)
# ============================================================
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=zhipuai/glm-5-2
AI_API_KEY=sk-or-...your-openrouter-key-here...

# ============================================================
# OPTION B: Local model via Ollama (free, private, slower)
# Install Ollama: https://ollama.com/download
# Then run: ollama pull glm4   (GLM-4-9B, ~5GB)
# Then run: ollama serve
# Uncomment these 3 lines and comment out Option A above:
# ============================================================
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=glm4
# AI_API_KEY=ollama

# ---- Free-model chain (Summarizer branch clerical prose only — optional) ----
# The Summarizer's report cards are fully generated in code with zero AI cost;
# these keys only add extra fallback slots for the OPTIONAL prose-polish pass
# (server/free-chain.js). Without them, only your AI_API_KEY's OpenRouter free
# models are tried, which get rate-limited under shared load — Groq/Gemini
# rarely do, so adding either makes prose generation far more reliable. Cards
# ship with clean template prose either way if every entry fails.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Admin ----
# Long random string — protects the moderation endpoints (/api/admin/*)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- Web server ----
PORT=3000

# Proof-of-work difficulty for anonymous tips (leading zero bits; 18 ≈ ~1–2s in browser)
POW_DIFFICULTY_BITS=18
